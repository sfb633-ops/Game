node_modules/
.env

# OS cruft
.DS_Store
Thumbs.db
desktop.ini

# Art review renders, not part of the build
art-review/

# Audio masters. The .ogg files beside them are what the game loads and what
# is committed; these are the uncompressed sources at about 10MB each, kept
# locally so a track can be re-encoded without going back for a re-export.
# Committing them would triple the repo permanently — git never forgets a blob.
public/media/*.wav

# Generated by tools/mine-maps.js and tools/at-scale.js: derived from the asset
# packs and rebuildable in one command, so it is not worth versioning.
art-review/compositions/
art-review/at-scale/
art-review/maps/
art-review/roofs.png
art-review/walls.png

# The detached server writes here; it is machine-local noise.
server.log
